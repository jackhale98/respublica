# Response headers for Cloudflare (docs/decisions.md 44). Each page also
# carries its own Content-Security-Policy in a <meta> tag with the hashes of
# its scripts; the header adds what a meta tag cannot set.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built scripts and styles carry a content hash in their names.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
