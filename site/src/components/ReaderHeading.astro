---
import { shortLabel } from "../lib/data.js";

// Division heading inside a reader page ("Article I", "Section 8").
const { block } = Astro.props;
const label = block.level === 1 ? block.label : shortLabel(block.label);
const space = label.lastIndexOf(" ");
const kicker = space > 0 ? label.slice(0, space) : null;
const num = space > 0 ? label.slice(space + 1) : label;
---
{block.level === 1 ? (
  <Fragment>
    <h2 class="rh rh-1" id={block.anchor} data-toc={block.ref}>
      {kicker ? <Fragment><span class="rh-kicker">{kicker}</span><span class="rh-num">{num}</span></Fragment> : label}
    </h2>
    {block.notes && <ul class="rh-notes" data-pagefind-ignore>{block.notes.map((n) => <li>{n}</li>)}</ul>}
  </Fragment>
) : (
  <h3 class="rh rh-2" id={block.anchor} data-toc={block.ref}>{label}</h3>
)}
