---
import { localUrl, shortLabel } from "../lib/data.js";
import WholeLinks from "./WholeLinks.astro";

// Division heading inside a reader page ("Article I", "Section 8").
const { block } = Astro.props;
const label = block.level === 1 ? block.label : shortLabel(block.label);
const space = label.lastIndexOf(" ");
const kicker = space > 0 ? label.slice(0, space) : null;
const num = space > 0 ? label.slice(space + 1) : label;
---
{block.level === 1 ? (
  <Fragment>
    <h2 class="rh rh-1" id={block.anchor} data-toc={block.ref} data-place={block.label}>
      {kicker ? <Fragment><span class="rh-kicker">{kicker}</span><span class="rh-num">{num}</span></Fragment> : label}
    </h2>
    {block.notes && <ul class="rh-notes" data-pagefind-ignore>{block.notes.map((n) => <li>{n}</li>)}</ul>}
    <WholeLinks block={block} />
    {block.changes && (
      <p class="rh-changes" data-pagefind-ignore>
        The National Archives marks text in{" "}
        {block.changes.map((c, i) => (
          <Fragment>
            {i > 0 && (i === block.changes.length - 1 ? " and " : ", ")}
            {localUrl(c.url) ? <a href={localUrl(c.url)}>{c.label}</a> : c.label}
          </Fragment>
        ))}{" "}
        as changed by this amendment.
      </p>
    )}
  </Fragment>
) : (
  <Fragment>
    <h3 class="rh rh-2" id={block.anchor} data-toc={block.ref} data-place={block.label}>{label}</h3>
    <WholeLinks block={block} />
  </Fragment>
)}
