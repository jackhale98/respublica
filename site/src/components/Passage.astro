---
import Icon from "./Icon.astro";
import { fixTitle, localUrl, safeUrl, uncertainTitle } from "../lib/data.js";

// One passage. Its element id is its ref, so /page/#Ref links to it.
const { block } = Astro.props;
const conns = block.connections || [];
const lines = block.paras.some((p) => p.length > 1);
const numeral = (label) => label.split(" ").at(-1);
---
<div
  class:list={["passage", { note: block.kind === "footnote", lines }]}
  id={block.ref}
  data-ref={block.ref}
  data-label={block.label}
  data-clause={block.clause_url ? localUrl(block.clause_url) : undefined}
>
  {(block.aliases || []).map((a) => <span class="alias" id={a} aria-hidden="true"></span>)}
  <a class="num" href={`#${block.ref}`} data-pagefind-ignore>{block.gutter || "·"}<span class="sr-only">{block.gutter ? ": " : ""}{block.label} ({block.ref})</span></a>
  <div class="ptext">
    {conns.length > 0 && (
      <span class="ccount" aria-hidden="true" data-pagefind-ignore title={`${conns.length} connection${conns.length === 1 ? "" : "s"}`}>
        <Icon name="link" />{conns.length}
      </span>
    )}
    {block.paras.map((lines) => (
      <p>
        {lines.map((runs, i) => (
          <Fragment>
            {i > 0 && <br />}
            {runs.map((r, k) => {
              const text = r.em ? <em>{r.t}</em> : r.t;
              const body = r.fix ? <span class="fix" title={fixTitle(r.fix)}>{text}</span>
                : r.unc ? <span class:list={["unc", r.lib && "lib"]} title={uncertainTitle(r.unc, r.lib)}>{text}</span> : text;
              if (r.chg === undefined) return body;
              const c = block.changed[r.chg];
              const lastOfSpan = !runs.slice(k + 1).some((x) => x.chg === r.chg);
              return (
                <Fragment>
                  <mark class="chg">{body}</mark>
                  {lastOfSpan && localUrl(c.url) && (
                    <sup class="chg-ref" data-pagefind-ignore>
                      <a href={localUrl(c.url)} title={`The National Archives marks this text as changed by ${c.label}`}>{numeral(c.label)}</a>
                    </sup>
                  )}
                </Fragment>
              );
            })}
          </Fragment>
        ))}
      </p>
    ))}
  </div>
  {block.changed.length > 0 && (
    <template class="chg-data" data-pagefind-ignore>
      The National Archives marks part of this text as changed by{" "}
      {block.changed.map((c, i) => (
        <Fragment>{i > 0 && (i === block.changed.length - 1 ? " and " : ", ")}{localUrl(c.url) ? <a href={localUrl(c.url)}>{c.label}</a> : c.label}</Fragment>
      ))}.
    </template>
  )}
  {block.scan && (
    <template class="src-data" data-pagefind-ignore>
      <p>
        Read from OCR scans of the printed page{block.scan.pages.length ? ` (${block.scan.unit || "p."} ${block.scan.pages.join("–")})` : ""}.{" "}
        {safeUrl(block.scan.url) && <a href={safeUrl(block.scan.url)} rel="noopener" target="_blank">View the page image</a>}
      </p>
      {block.uncertain > 0 && (
        <ul class="unc-list">
          {block.paras.flat(2).filter((r) => r.unc).map((r) => <li><span class:list={["unc", r.lib && "lib"]}>{r.t}</span> {uncertainTitle(r.unc, r.lib).replace("Uncertain reading. ", "")}</li>)}
        </ul>
      )}
    </template>
  )}
  {block.printed && (
    <template class="src-data" data-pagefind-ignore>
      <p>
        Printed on p. {block.printed.page} of the United States Reports, read from the text layer of {block.printed.from}.{" "}
        {safeUrl(block.printed.url) && <a href={safeUrl(block.printed.url)} rel="noopener" target="_blank">View the page image</a>}
      </p>
    </template>
  )}
  {conns.length > 0 && (
    <details class="conns" data-pagefind-ignore>
      <summary>{conns.length} connection{conns.length === 1 ? "" : "s"}</summary>
      <ul class="conn-mini">
        {conns.map((c) => (
          <li>
            {c.verb}{" "}
            {localUrl(c.other_url) ? <a href={localUrl(c.other_url)}>{c.other_label}</a> : c.other_label}
            {c.status === "suggested" && " (suggested)"}
            {c.other_overruled && " (overruled)"}
          </li>
        ))}
      </ul>
    </details>
  )}
</div>
