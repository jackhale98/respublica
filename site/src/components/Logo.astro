---
// Res Publica mark: a pen nib. The breather hole doubles as a node, for
// passages joined by links. Pass a unique id when used twice on a page.
const { id = "rp-grad" } = Astro.props;
---
<svg viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={id} gradientUnits="userSpaceOnUse" x1="10" y1="4" x2="54" y2="61">
      <stop offset="0" stop-color="#5b4cf0" />
      <stop offset=".55" stop-color="#7b5cff" />
      <stop offset="1" stop-color="#1fb5d3" />
    </linearGradient>
  </defs>
  <path fill={`url(#${id})`} fill-rule="evenodd" d="M22 8.5Q22 4 26.5 4H37.5Q42 4 42 8.5V14C51 21 54 29 50.5 37.5L32 61L13.5 37.5C10 29 13 21 22 14ZM27.4 29a4.6 4.6 0 1 0 9.2 0a4.6 4.6 0 1 0 -9.2 0ZM30.8 33.4H33.2V58.2H30.8Z" />
</svg>
