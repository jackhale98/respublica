---
// Res Publica mark: a pediment on three columns.
const { id = "rp-grad" } = Astro.props;
---
<svg viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5b4cf0" />
      <stop offset=".55" stop-color="#7b5cff" />
      <stop offset="1" stop-color="#1fb5d3" />
    </linearGradient>
  </defs>
  <g fill={`url(#${id})`}>
    <path d="M16 3.5 29 10.5H3Z" />
    <rect x="5.5" y="12.5" width="4" height="11.5" rx="1" />
    <rect x="14" y="12.5" width="4" height="11.5" rx="1" />
    <rect x="22.5" y="12.5" width="4" height="11.5" rx="1" />
    <rect x="3" y="25.5" width="26" height="3" rx="1.5" />
  </g>
</svg>
