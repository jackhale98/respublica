---
import { LINK_TYPE_LABELS, refUrl } from "../lib/data.js";

// Connections for one passage. Shown inline under the passage for now;
// the side panel and graph view come in phase 4.
// Incoming links are marked with an arrow ("← cites" = the other passage cites this one).
const { links = [] } = Astro.props;
---
{links.length > 0 && (
  <details class="connections">
    <summary>{links.length} connection{links.length === 1 ? "" : "s"}</summary>
    <ul>
      {links.map((l) => {
        const href = refUrl(l.other);
        return (
          <li class:list={["conn", `status-${l.status}`]}>
            <span class="conn-type">{l.direction === "out" ? (LINK_TYPE_LABELS[l.type] || l.type) : `← ${LINK_TYPE_LABELS[l.type] || l.type}`}</span>{" "}
            {href ? <a href={href}>{l.other_label}</a> : <span>{l.other_label}</span>}
            {l.other_overruled && <strong class="overruled"> (overruled)</strong>}
            {l.status === "suggested" && <span class="badge">suggested</span>}
            {l.other_quote && <blockquote>{l.other_quote}</blockquote>}
            {l.rationale && <p class="rationale">{l.rationale}</p>}
            {l.source && <p class="source">Source: {l.source}</p>}
          </li>
        );
      })}
    </ul>
  </details>
)}
