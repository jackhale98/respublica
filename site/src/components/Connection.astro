---
import { localUrl } from "../lib/data.js";

// One connection, seen from the current passage.
const { conn: c } = Astro.props;
const href = localUrl(c.other_url);
---
<li class:list={["conn", c.status]}>
  <div class="conn-top">
    <span class="conn-verb">{c.verb}</span>
    {c.status === "suggested" && <span class="badge suggested" title="Proposed by a machine; not yet reviewed by a person">Suggested</span>}
    {c.status === "reviewed" && <span class="badge reviewed">Reviewed</span>}
    {c.other_overruled && <span class="badge overruled">Overruled</span>}
  </div>
  {href ? <a class="conn-target" href={href}>{c.other_label}</a> : <span class="conn-target">{c.other_label}</span>}
  {c.other_quote && <blockquote>{c.other_quote}</blockquote>}
  {c.rationale && <p class="why">{c.rationale}</p>}
  {c.source && <p class="src">Source: {c.source}</p>}
</li>
