---
import Runs from "./Runs.astro";
import { href } from "../lib/data.js";

// Heading lines of an essay or letter as printed in its edition (newspaper,
// number, date), and a note on how the text was read from scans, or (`typed`)
// typed by the Text Creation Partnership (decision 69).
const { header, notes = 0, typed = false } = Astro.props;
---
{header?.publication?.length > 0 && (
  <div class="doc-lines" data-pagefind-ignore>
    {header.publication.map((runs) => <p><Runs runs={runs} /></p>)}
  </div>
)}
{typed ? (
  <p class="doc-note" data-pagefind-ignore>
    Typed by the Text Creation Partnership from page images of the first printing, with its spelling and the long
    s (ſ).{" "}<span class="unc">Dotted words</span> hold letters the transcribers could not read (• a letter, 〈◊〉
    a word), left as they marked them.{" "}<a href={href("/about/#ocr")}>How this text was made</a>
  </p>
) : (
  <p class="doc-note" data-pagefind-ignore>
    Read from OCR scans of the printed page and, where there is more than one scan, checked word by word against
    the others.{" "}<span class="unc">Dotted words</span> are ones the scans disagree on or read poorly; select a
    paragraph to see their readings and the page image.{" "}<a href={href("/about/#ocr")}>How this text was made</a>
  </p>
)}
