---
import "../../styles/collection.css";
import "../../styles/about.css";
import Base from "../../layouts/Base.astro";
import { href, formatDate, formatNumber, loadManifest, loadSite, safeUrl } from "../../lib/data.js";

// The road to independence (decision 66): the documents of 1774-1776 that
// lead to the Declaration, in the order they were adopted.
const { page } = Astro.props;
const works = Object.fromEntries(loadSite().works.map((w) => [w.id, w]));
const all = page.works.map((id) => works[id]);
const words = all.reduce((s, w) => s + w.words, 0);
const sourceById = Object.fromEntries(loadManifest().map((s) => [s.id, s]));
---
<Base title={page.title} section="independence" description="The documents on the road to the Declaration of Independence, 1774–1776: the resolves and declarations of the Continental Congress, the Lee Resolution, the Virginia Declaration of Rights and Jefferson's draft preamble, with a permanent reference for every paragraph.">
  <section class="page-head">
    <div class="container">
      <ol class="crumbs"><li><a href={href("/")}>Library</a></li><li aria-current="page">The road to independence</li></ol>
      <h1>The Road to Independence</h1>
      <p class="lede">
        From the First Continental Congress's resolves of 1774 to the vote of July 2, 1776: the documents that lead
        to the <a href={href("/declaration/")}>Declaration of Independence</a>, as the Journals of the Continental
        Congress, the printings of the time and Jefferson's papers give them.
      </p>
      <div class="doc-stats">
        <span><strong>{all.length}</strong> works</span>
        <span><strong>{formatNumber(all.reduce((s, w) => s + w.passages, 0))}</strong> paragraphs</span>
        <span><strong>{Math.round(words / 1000)}k</strong> words</span>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="debate-group" aria-labelledby="road-h">
      <h2 id="road-h" class="sr-only">Documents</h2>
      <ol class="debate-works">
        {all.map((w) => (
          <li>
            <a class="card debate-work" href={href(w.url)}>
              <h3>{w.title}</h3>
              <p class="by">{w.summary}</p>
              <div class="paper-foot">
                <span>{formatDate(w.date)}</span>
                <span>{w.edition.name.split(" (")[0].replace(/^.*?, ed\., /, "")}</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="debate-group" aria-labelledby="editions">
      <h2 id="editions">Editions and sources</h2>
      {all.map((w) => (
        <section class="edition card">
          <h3>{w.title}</h3>
          <p class="muted">{w.edition.name}</p>
          <p>{w.edition.notes}</p>
          <ul class="src-list">
            {w.source_ids.map((id) => sourceById[id]).filter(Boolean).map((s) => {
              const url = safeUrl(s.url);
              return (
                <li>
                  {url ? <a href={url} rel="noopener noreferrer">{s.notes || s.id}</a> : (s.notes || s.id)}
                  <span class="muted"> Retrieved {formatDate(s.retrieved_at)}. {s.license}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </section>
  </div>
</Base>
