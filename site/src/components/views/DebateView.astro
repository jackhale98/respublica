---
import "../../styles/collection.css";
import Base from "../../layouts/Base.astro";
import Continue from "../Continue.astro";
import { href, formatDate, readingMinutes } from "../../lib/data.js";

// Index of a debate in Congress: one entry per item, a day on which the house
// took up the subject (two on one day are numbered).
const { work } = Astro.props;
const parts = work.parts;
const words = parts.reduce((s, p) => s + p.words, 0);
---
<Base title={work.title} section="congress" description={`${work.title}, ${formatDate(work.date)}: ${work.summary || ""} A permanent reference for every paragraph.`}>
  <section class="page-head">
    <div class="container">
      <ol class="crumbs">
        <li><a href={href("/")}>Library</a></li>
        <li><a href={href("/congress/")}>Debates in Congress</a></li>
        <li aria-current="page">{work.short}</li>
      </ol>
      <span class="eyebrow">Debates in Congress</span>
      <h1>{work.title}</h1>
      <p class="lede">{formatDate(work.date)}. {work.summary}</p>
      <div class="doc-stats">
        <span><strong>{parts.length}</strong> {parts.length === 1 ? "item" : "items"}</span>
        <span><strong>{work.passages.toLocaleString("en-US")}</strong> paragraphs</span>
        <span><strong>{words >= 1000 ? `${Math.round(words / 1000)}k` : words}</strong> words</span>
      </div>
    </div>
  </section>

  <div class="container">
    <Continue work={work.url.split("/")[1]} />
    <ol class="papers">
      {parts.map((p, i) => (
        <li>
          <a class="card paper" href={href(p.url)}>
            <div class="paper-top">
              <span class="paper-no">{i + 1}</span>
            </div>
            <h3>{p.label}</h3>
            <div class="paper-foot">
              <span>{p.passages} paragraphs</span>
              <span>{readingMinutes(p.words)} min</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
    <p class="legend-note">
      Text of {work.edition.name}, read from OCR; the debates are given as reported, not always word for word.
      <a href={href("/about/#ocr")}>How this text was made</a>
    </p>
  </div>
</Base>
