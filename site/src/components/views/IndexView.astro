---
import "../../styles/collection.css";
import Base from "../../layouts/Base.astro";
import AuthorChip from "../AuthorChip.astro";
import Icon from "../Icon.astro";
import { AUTHORS, authorKey, formatDate, newspaper, printedDate, readingMinutes } from "../../lib/data.js";

// Index of a paged work: The Federalist's 85 papers, filterable by author.
const { work } = Astro.props;
const parts = work.parts;
const counts = Object.fromEntries(AUTHORS.map((a) => [a.key, parts.filter((p) => authorKey(p.attribution) === a.key).length]));
const total = parts.length;

// Part-to-whole bar: one row, segments in the fixed author order, 2px gaps.
const W = 1000, H = 14, GAP = 2;
let x = 0;
const segs = AUTHORS.filter((a) => counts[a.key]).map((a) => {
  const w = (counts[a.key] / total) * W;
  const seg = { key: a.key, label: a.label, n: counts[a.key], x: x + (x ? GAP / 2 : 0), w: w - (x ? GAP / 2 : 0) - (x + w < W - 0.5 ? GAP / 2 : 0) };
  x += w;
  return seg;
});
const words = parts.reduce((s, p) => s + p.words, 0);
---
<Base title={work.title} section={work.id} description={`All ${total} papers of ${work.title}, with author, newspaper and date, and a permanent reference for every paragraph.`}>
  <section class="page-head">
    <div class="container">
      <ol class="crumbs"><li><a href="/">Library</a></li><li aria-current="page">{work.short}</li></ol>
      <h1>{work.title}</h1>
      <p class="lede">
        {total} essays by “Publius” in New York newspapers, {formatDate(work.date)}, written by Alexander Hamilton,
        James Madison and John Jay. Every paragraph has a permanent reference.
      </p>
      <div class="doc-stats">
        <span><strong>{total}</strong> papers</span>
        <span><strong>{work.passages.toLocaleString("en-US")}</strong> paragraphs</span>
        <span><strong>{Math.round(words / 1000)}k</strong> words</span>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="card authorship" aria-labelledby="authors-h">
      <h2 id="authors-h">Authorship in this edition</h2>
      <svg class="author-bar" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img"
        aria-label={segs.map((s) => `${s.label}: ${s.n}`).join(", ")}>
        <defs>
          <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="8" height="8" class="seg-disputed" />
            <rect width="3" height="8" class="hatch-line" />
          </pattern>
        </defs>
        {segs.map((s, i) => (
          <rect class={`seg-${s.key}`} x={s.x} y="0" width={Math.max(s.w, 1)} height={H}
            rx={i === 0 || i === segs.length - 1 ? 4 : 0} fill={s.key === "disputed" ? "url(#hatch)" : undefined}>
            <title>{s.label}: {s.n} of {total}</title>
          </rect>
        ))}
      </svg>
      <div class="filters" role="group" aria-label="Filter papers by author" data-filters>
        <button type="button" aria-pressed="true" data-author="">All <span>{total}</span></button>
        {AUTHORS.filter((a) => counts[a.key]).map((a) => (
          <button type="button" aria-pressed="false" data-author={a.key}>
            <span class:list={["dot", a.key]} aria-hidden="true"></span>{a.label} <span>{counts[a.key]}</span>
          </button>
        ))}
        <label class="filter-search">
          <Icon name="search" />
          <span class="sr-only">Filter papers by title or number</span>
          <input type="search" placeholder="Filter by title or number" data-filter-text />
        </label>
      </div>
      <p class="legend-note">
        Bylines follow the base edition. “Disputed” papers are marked HAMILTON OR MADISON there; “joint” papers
        HAMILTON AND MADISON. <a href="/about/#editions">About this edition</a>
      </p>
    </section>

    <p class="showing" aria-live="polite" data-showing>Showing all {total} papers</p>

    <ol class="papers" data-papers>
      {parts.map((p) => {
        const date = printedDate(p.publication);
        return (
          <li data-author={authorKey(p.attribution)} data-text={`${p.label.split(" ").at(-1)} ${p.title}`.toLowerCase()}>
            <a class="card paper" href={p.url}>
              <div class="paper-top">
                <span class="paper-no">{p.label.split(" ").at(-1)}</span>
                <AuthorChip attribution={p.attribution} short />
              </div>
              <h3>{p.title}</h3>
              <div class="paper-foot">
                <span>{newspaper(p.publication)}{date && ` · ${date}`}</span>
                <span>{readingMinutes(p.words)} min</span>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
    <p class="no-match" hidden data-no-match>No papers match. <button type="button" class="linkish" data-reset>Show all</button></p>
  </div>
  <script>
    import "../../scripts/collection.ts";
  </script>
</Base>
