---
import { href } from "../lib/data.js";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource-variable/source-serif-4/wght.css";
import "@fontsource-variable/source-serif-4/wght-italic.css";
// The two faces nearly every page sets its text in, fetched early so the swap
// from the fallback font does not shift the text (Lighthouse layout shift).
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import serifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/search.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import LogoEgg from "../components/LogoEgg.astro";

const {
  title,
  description = "A free, open library of America's founding texts, with a permanent reference for every passage and verified links between them.",
  section,
} = Astro.props;
const pageTitle = title ? `${title} · Res Publica` : "Res Publica: America's founding texts, connected";
const nav = [
  { href: "/declaration/", label: "Declaration", key: "declaration" },
  { href: "/constitution/", label: "Constitution", key: "constitution" },
  { href: "/amendments/", label: "Amendments", key: "amendments" },
  { href: "/federalist/", label: "The Federalist", short: "Federalist", key: "federalist" },
  { href: "/ratification/", label: "Debate", short: "Debate", key: "ratification" },
  { href: "/cases/", label: "Cases", key: "cases" },
  { href: "/map/", label: "Map", key: "map" },
  { href: "/about/", label: "About", key: "about" },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c14" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={href("/favicon.ico")} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="manifest" href={href("/site.webmanifest")} />
    <script is:inline src={href("/theme.js")}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={href("/")} aria-label="Res Publica home"><Logo /><span>Res Publica</span></a>
        <nav class="primary-nav" aria-label="Primary">
          {nav.map((n) => (
            <a href={href(n.href)} aria-current={section === n.key ? "page" : undefined}>
              {n.short && n.short !== n.label ? <Fragment><span class="nav-long">{n.label}</span><span class="nav-short">{n.short}</span></Fragment> : n.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="icon-btn search-trigger" href={href("/search/")} data-search-open aria-label="Search or jump to… (press /)">
            <Icon name="search" /><span class="label">Search or jump to…</span><kbd>/</kbd>
          </a>
          <button class="icon-btn js-only" type="button" data-history-open aria-label="Where you've been" title="Where you've been"><Icon name="clock" /></button>
          <button class="icon-btn js-only prefs-btn" type="button" data-prefs-open aria-label="Reading settings" title="Reading settings" aria-expanded="false" aria-controls="prefs"><span aria-hidden="true">Aa</span></button>
        </div>
        <div class="prefs" id="prefs" role="dialog" aria-label="Reading settings" data-prefs hidden>
          <div class="prefs-row">
            <span class="prefs-label" id="prefs-size">Text size</span>
            <div class="prefs-seg" role="group" aria-labelledby="prefs-size">
              <button type="button" data-size-step="-1" aria-label="Smaller text"><span class="a-sm">A</span>−</button>
              <output data-size-label>Medium</output>
              <button type="button" data-size-step="1" aria-label="Larger text"><span class="a-lg">A</span>+</button>
            </div>
          </div>
          <div class="prefs-row">
            <span class="prefs-label" id="prefs-leading">Line spacing</span>
            <div class="prefs-seg" role="group" aria-labelledby="prefs-leading">
              <button type="button" data-leading-set="normal">Normal</button>
              <button type="button" data-leading-set="relaxed">Relaxed</button>
            </div>
          </div>
          <div class="prefs-row">
            <span class="prefs-label" id="prefs-theme">Theme</span>
            <div class="prefs-seg" role="group" aria-labelledby="prefs-theme">
              <button type="button" data-theme-set="system"><Icon name="system" />System</button>
              <button type="button" data-theme-set="light"><Icon name="sun" />Light</button>
              <button type="button" data-theme-set="dark"><Icon name="moon" />Dark</button>
            </div>
          </div>
          <p class="prefs-note">Kept in this browser only. Text size applies to the library's texts everywhere.</p>
        </div>
      </div>
      <nav class="mobile-nav" aria-label="Primary">
        {nav.map((n) => <a href={href(n.href)} aria-current={section === n.key ? "page" : undefined}>{n.short || n.label}</a>)}
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div>
          <div class="brand"><LogoEgg /><a href={href("/")}>Res Publica</a></div>
          <p>
            A free, nonpartisan, open-source library of America's founding texts. Every text is imported
            by code from a public-domain original, and every connection shows who made it and whether a
            person has reviewed it.
          </p>
        </div>
        <div>
          <h2>Read</h2>
          <ul>
            <li><a href={href("/declaration/")}>The Declaration of Independence</a></li>
            <li><a href={href("/constitution/")}>The Constitution</a></li>
            <li><a href={href("/amendments/")}>Amendments</a></li>
            <li><a href={href("/federalist/")}>The Federalist</a></li>
            <li><a href={href("/ratification/")}>The ratification debate</a></li>
            <li><a href={href("/congress/")}>Debates in Congress</a></li>
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href={href("/about/")}>About &amp; editions</a></li>
            <li><a href={href("/search/")}>Search</a></li>
            <li><a href={href("/map/")}>Map of connections</a></li>
            <li><a href={href("/review/")}>Review links</a></li>
            <li><a href={href("/errata/")}>Review errata</a></li>
            <li><a href="https://commonhall.org/" rel="noopener">CommonHall</a></li>
            <li><a href="https://github.com/jackhale98/respublica" rel="noopener">Source code</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <dialog class="search-dialog" id="search-dialog" aria-label="Search">
      <form class="search-box" method="dialog" role="search" data-search-form>
        <Icon name="search" />
        <input type="search" name="q" placeholder="Search texts, or jump to “Fed 10” or “1.8.3”" autocomplete="off" spellcheck="false" aria-label="Search" aria-controls="search-results" data-search-input />
        <button type="button" class="icon-btn" data-search-close aria-label="Close search"><kbd>Esc</kbd></button>
      </form>
      <div class="search-results" id="search-results" role="listbox" aria-label="Results" data-search-results></div>
      <a class="sr-all" href={href("/search/")} data-search-all hidden>See all results for “<span data-q></span>” <kbd>Enter</kbd></a>
      <div class="search-foot">
        <span><kbd>Enter</kbd> all results</span>
        <span><kbd>↑</kbd> <kbd>↓</kbd> then <kbd>Enter</kbd> to open one</span>
        <span class="hide-sm">Try “Federalist 51”, “Article I, Section 8”, “Amendment 14”</span>
      </div>
    </dialog>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <div class="back-chip" data-back-chip hidden>
      <a href="#" data-back-chip-link><Icon name="left" /><span>Back to <strong data-back-chip-label></strong></span></a>
      <button type="button" class="icon-btn" data-back-chip-close aria-label="Dismiss"><Icon name="x" /></button>
    </div>
    <dialog class="history-dialog" aria-labelledby="history-title" data-history-dialog>
      <header class="history-head">
        <h2 id="history-title">Where you've been</h2>
        <button type="button" class="icon-btn" data-history-close aria-label="Close"><Icon name="x" /></button>
      </header>
      <div class="history-actions">
        <button type="button" class="btn btn-ghost" data-history-step="-1"><Icon name="left" />Back</button>
        <button type="button" class="btn btn-ghost" data-history-step="1">Forward<Icon name="right" /></button>
        <button type="button" class="btn btn-ghost history-clear" data-history-clear>Clear</button>
      </div>
      <ol class="history-list" data-history-list></ol>
      <p class="history-note">The places you have read, newest first, kept in this browser only. Nothing is sent anywhere.</p>
    </dialog>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
