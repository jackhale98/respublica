---
import "../styles/reader.css";
import "../styles/graph.css";
import Base from "./Base.astro";
import { href } from "../lib/data.js";
import Icon from "../components/Icon.astro";
import Panel from "../components/Panel.astro";

// Reader shell: contents (slot "toc"), the text (default slot) and the
// passage panel (slot "panel" holds its default content).
// `place` names the page in the floating bar that appears when the reader
// scrolls back up ("Federalist No. 10", "Constitution"); the bar adds the
// division being read on pages with headings.
const { title, description, section, progress = false, pageId, place = title } = Astro.props;
---
<Base title={title} description={description} section={section}>
  {progress && <div class="progress" aria-hidden="true"></div>}
  <div class="placebar" data-placebar inert>
    <div class="container placebar-inner">
      <button class="placebar-btn" type="button" data-placebar-open aria-label="Open contents">
        <Icon name="list" />
        <span class="placebar-text">
          <span class="placebar-work">{place}</span>
          <span class="placebar-here" data-placebar-here></span>
        </span>
      </button>
      <button class="icon-btn placebar-top" type="button" data-placebar-top aria-label="Back to top"><Icon name="up" /></button>
    </div>
  </div>
  <div class="container reader" data-reader data-conn-url={href(`/data/conn/${pageId}.json`)} data-graph-url={href(`/data/graph/${pageId}.json`)}>
    <nav class="toc" id="toc" aria-label="Contents" data-toc-nav>
      <button class="icon-btn toc-close" type="button" data-toc-close aria-label="Close contents"><Icon name="x" /></button>
      <slot name="toc" />
    </nav>
    <article class="sheet" data-pagefind-body>
      <div class="sheet-inner">
        <div class="reader-tools" data-pagefind-ignore>
          <slot name="crumbs" />
          <button class="icon-btn toc-open" type="button" data-toc-open aria-controls="toc" aria-label="Contents"><Icon name="list" /><span>Contents</span></button>
          <button class="icon-btn js-only prefs-btn" type="button" data-prefs-open aria-label="Reading settings" title="Reading settings" aria-controls="prefs"><span aria-hidden="true">Aa</span></button>
        </div>
        <slot />
      </div>
    </article>
    <Panel><slot name="panel" /></Panel>
  </div>
  <div class="scrim" data-scrim></div>
  <dialog class="graph-dialog" aria-labelledby="graph-title" data-graph-dialog>
    <header class="graph-head">
      <div>
        <span class="eyebrow">Connections graph</span>
        <h2 id="graph-title" data-graph-title></h2>
      </div>
      <button class="icon-btn" type="button" data-graph-close aria-label="Close graph"><Icon name="x" /></button>
    </header>
    <div class="graph-filters" role="group" aria-label="Filter the graph" data-graph-filters></div>
    <div class="graph-body">
      <div class="graph-canvas">
        <svg role="group" data-graph-svg></svg>
        <div class="graph-zoom" role="group" aria-label="Zoom" data-graph-controls>
          <button type="button" class="icon-btn" data-zoom="in" aria-label="Zoom in">+</button>
          <button type="button" class="icon-btn" data-zoom="out" aria-label="Zoom out">−</button>
          <button type="button" class="icon-btn fit" data-zoom="fit" aria-label="Fit to view">Fit</button>
        </div>
      </div>
      <aside class="graph-info" aria-live="polite" data-graph-info></aside>
    </div>
    <div class="graph-legend" data-graph-legend></div>
  </dialog>
  <script>
    import "../scripts/reader.ts";
  </script>
</Base>
