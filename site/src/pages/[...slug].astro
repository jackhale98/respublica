---
import CollectionView from "../components/views/CollectionView.astro";
import IndexView from "../components/views/IndexView.astro";
import DebateView from "../components/views/DebateView.astro";
import CongressView from "../components/views/CongressView.astro";
import IndependenceView from "../components/views/IndependenceView.astro";
import SeriesView from "../components/views/SeriesView.astro";
import PaperView from "../components/views/PaperView.astro";
import WorkView from "../components/views/WorkView.astro";
import SourcesView from "../components/views/SourcesView.astro";
import CaseView from "../components/views/CaseView.astro";
import CasesView from "../components/views/CasesView.astro";
import ClauseView from "../components/views/ClauseView.astro";
import { loadPage, loadSite } from "../lib/data.js";

// Every reader and index page comes from site/.data (tools/site_data.py),
// which fixes the URL of each page.
export function getStaticPaths() {
  const site = loadSite();
  const works = Object.fromEntries(site.works.map((w) => [w.id, w]));
  return site.pages.map((p) => {
    const page = loadPage(p.id);
    return { params: { slug: p.url.replace(/^\/|\/$/g, "") }, props: { page, work: page.work ? works[page.work.id] : null } };
  });
}

const { page, work } = Astro.props;
---
{page.kind === "work" && <WorkView page={page} work={work} />}
{page.kind === "part" && <PaperView page={page} work={work} />}
{page.kind === "index" && (work.collection === "ratification" ? <SeriesView work={work} /> : work.collection === "congress" ? <DebateView work={work} /> : work.collection === "sources" ? <SourcesView work={work} /> : <IndexView work={work} />)}
{page.kind === "collection" && <CollectionView page={page} />}
{page.kind === "congress" && <CongressView page={page} />}
{page.kind === "independence" && <IndependenceView page={page} />}
{page.kind === "case" && <CaseView page={page} />}
{page.kind === "cases" && <CasesView page={page} />}
{page.kind === "clause" && <ClauseView page={page} />}
