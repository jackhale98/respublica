---
import Base from "../../../layouts/Base.astro";
import Segment from "../../../components/Segment.astro";
import { anchor, loadLinkIndex, loadWorks } from "../../../lib/data.js";

export function getStaticPaths() {
  return loadWorks().map((work) => ({ params: { work: work.id }, props: { work } }));
}

const { work } = Astro.props;
const links = loadLinkIndex().by_ref;
const tops = work.groups.filter((g) => g.division);
const subs = (work.divisions || []).filter((d) => d.level === 2);
// Second-level headings (e.g. "Section 8") go before the first passage under them.
const headingBefore = new Map();
for (const d of subs) {
  const first = work.segments.find((s) => s.ref.startsWith(d.ref + "."));
  if (first) headingBefore.set(first.ref, d);
}
---
<Base title={work.title}>
  <article class="work">
    <h1>{work.title}</h1>
    <p class="edition">Edition: {work.edition.name}. <a href="/about/">About this edition</a></p>

    <nav class="toc" aria-label="Contents">
      <h2>Contents</h2>
      <ol>
        {tops.map((g) => (
          <li>
            <a href={work.split ? `${g.slug}/` : `#${anchor(g.division.ref)}`}>{g.division.label}</a>
            {g.division.title && <span class="toc-title"> — {g.division.title}</span>}
            {!work.split && subs.some((d) => d.ref.startsWith(g.division.ref + ".")) && (
              <ol>
                {subs.filter((d) => d.ref.startsWith(g.division.ref + ".")).map((d) => (
                  <li><a href={`#${anchor(d.ref)}`}>{d.label.split(", ").at(-1)}</a></li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>

    {!work.split && work.groups.map((g) => (
      <section class="division" id={g.division ? anchor(g.division.ref) : undefined}>
        {g.division && <h2>{g.division.label}</h2>}
        {g.division?.notes && (
          <ul class="div-notes">{g.division.notes.map((n) => <li>{n.text}</li>)}</ul>
        )}
        {g.segments.map((s) => {
          const sub = headingBefore.get(s.ref);
          return (
            <>
              {sub && <h3 id={anchor(sub.ref)}>{sub.label.split(", ").at(-1)}</h3>}
              <Segment segment={s} links={links[s.ref] || []} />
            </>
          );
        })}
      </section>
    ))}
  </article>
</Base>
