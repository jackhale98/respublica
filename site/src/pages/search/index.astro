---
import { href } from "../../lib/data.js";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
---
<Base title="Search" description="Search the full text of the library, or jump straight to a passage by its reference.">
  <section class="page-head">
    <div class="container">
      <h1>Search</h1>
      <p class="lede">Search every passage, or jump to one: try “Federalist 51”, “1.8.3”, “Amendment 14” or “art 2 sec 1”.</p>
    </div>
  </section>
  <div class="container search-page" data-search-page>
    <form class="search-box" role="search" action={href("/search/")} method="get">
      <Icon name="search" />
      <input type="search" name="q" placeholder="Search the library" autocomplete="off" aria-label="Search" data-search-input />
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
    <div class="search-filters" role="group" aria-label="Filter by text" data-work-filters></div>
    <div class="search-filters" role="group" aria-label="Filter by author" data-author-filters hidden></div>
    <noscript><p class="sr-empty">Search needs JavaScript. Browse the <a href={href("/")}>library</a> instead.</p></noscript>
    <div class="search-results" data-jumps></div>
    <p class="srp-summary" aria-live="polite" data-summary></p>
    <div class="srp-list" data-results></div>
    <button class="btn btn-ghost srp-more" type="button" data-more hidden>Show more</button>
  </div>
  <script>
    import "../../scripts/search-page.ts";
  </script>
</Base>
