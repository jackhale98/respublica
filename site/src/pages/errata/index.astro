---
// Errata: every word the scans could not settle, by work, for a maintainer to
// read off the page image. Decisions are sent as a GitHub issue that the
// review workflow records under the maintainer's GitHub login, and the
// importers apply (docs/decisions.md 48; docs/ocr.md, "Correcting words").
// The data comes from tools/site_data.py.
import { href, loadErrata, formatNumber } from "../../lib/data.js";
import Base from "../../layouts/Base.astro";
import "../../styles/review.css";
import "../../styles/errata.css";

// Page images come from the Internet Archive and the UNT Digital Library; only this page loads them.
Astro.csp.insertDirective("img-src 'self' https://archive.org https://*.us.archive.org https://digital.library.unt.edu");
const errata = loadErrata();
---
<Base title="Review errata" description="Read uncertain words off the page images and record what is printed. For maintainers of Res Publica.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">For maintainers</span>
      <h1>Review errata</h1>
      <p class="lede">
        {formatNumber(errata.total)} words could not be settled by comparing the scans. Open a work, look at each
        word on the page image, and record what is printed. When you are done, send your corrections as a GitHub
        issue: the review workflow records them under your GitHub name, the importers apply them, and the site is
        redeployed.{errata.corrected > 0 && ` ${formatNumber(errata.corrected)} words have been corrected so far.`}
      </p>
    </div>
  </section>

  <div class="container review" data-errata data-repo={errata.repo}>
    <aside class="review-help card">
      <h2>How it works</h2>
      <ol>
        <li>Each word is shown with the words around it and what every scan read. Choose <strong>Page image</strong> to see the printed page, and find the word on it.</li>
        <li>If one of the readings is what the page shows, choose it. Otherwise type exactly what is printed: the old spelling and punctuation, not a modern one. Leave a word alone if you cannot read it.</li>
        <li>Choose <strong>Send to GitHub</strong>. GitHub opens a new issue listing your corrections; submit it. Only people with write access to the repository are counted.</li>
      </ol>
      <p>Corrections are kept in this browser until you send them. Each is applied by the importers and logged with your name (<a href={`https://github.com/${errata.repo}/blob/main/docs/ocr.md`} rel="noopener">how the text is read</a>).</p>
    </aside>

    <noscript><p class="review-empty">Reviewing errata needs JavaScript.</p></noscript>

    <section class="review-group">
      <div class="review-batches">
        {errata.works.filter((w) => w.words > 0).map((w) => (
          <details class="review-batch card" data-work={w.id} data-count={w.words}>
            <summary>
              <span class="rb-label">{w.title}<span class="er-edition">{w.edition}</span></span>
              <span class="rb-count" data-work-count>{formatNumber(w.words)} {w.words === 1 ? "word" : "words"} in {formatNumber(w.passages)} {w.passages === 1 ? "passage" : "passages"}</span>
            </summary>
            <div class="rb-body" data-work-body><p class="review-empty">Loading…</p></div>
          </details>
        ))}
      </div>
    </section>
    {errata.total === 0 && <p class="review-empty">Nothing to review: every uncertain word has been settled.</p>}
  </div>

  <div class="review-bar" data-review-bar hidden>
    <div class="container review-bar-inner">
      <p class="rb-tally" aria-live="polite" data-tally></p>
      <button class="btn btn-ghost" type="button" data-clear>Clear</button>
      <a class="btn btn-primary" data-send href="#" target="_blank" rel="noopener">Send to GitHub</a>
    </div>
  </div>
  <script>
    import "../../scripts/errata.ts";
  </script>
</Base>
